{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "types": ["node"],
      "rootDir": "src",
      "outDir": "dist",
      "noEmitOnError": true,
      "strict": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }